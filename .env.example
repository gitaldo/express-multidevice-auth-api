# ========================================
# 🚀 EXPRESS MULTIDEVICE AUTH API
# Environment Configuration Template
# ========================================

# 🌐 APPLICATION CONFIGURATION
# ========================================
NODE_ENV="development"
PORT="3000"
APP_URL=http://localhost:3000
APP_URL_FE=http://localhost:3000

# 🗄️ DATABASE CONFIGURATION
# ========================================
DATABASE_URL="postgresql://username:password@localhost:5432/multidevice_auth_db?schema=public"

# 🔐 JWT AUTHENTICATION CONFIGURATION
# ========================================
JWT_ACCESS_SECRET="your-64-character-super-secure-access-secret-key-for-jwt-tokens-here"
JWT_REFRESH_SECRET="your-64-character-super-secure-refresh-secret-key-for-jwt-tokens-here"
JWT_DEVICE_VERIFY_SECRET="your-64-character-device-verification-secret-key-for-jwt-here"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS="7"
JWT_ISSUER="express-multidevice-auth-api"


# 🎯 REDIS CONFIGURATION (Sessions, Cache, Rate Limiting)
# ========================================
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# 📧 EMAIL SERVICE CONFIGURATION (SMTP)
# ========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_SERVICE="gmail"



